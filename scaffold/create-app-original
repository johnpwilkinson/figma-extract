#!/bin/bash
# create-shadcn-app - One-liner to create a fully configured Vite + React + shadcn/ui project
# Usage: create-shadcn-app <project-name>

set -e

PROJECT_NAME="${1:-}"

if [ -z "$PROJECT_NAME" ]; then
  echo "Usage: create-shadcn-app <project-name>"
  exit 1
fi

# Check if directory already exists
if [ -d "$PROJECT_NAME" ]; then
  echo "Error: Directory '$PROJECT_NAME' already exists"
  exit 1
fi

echo "🚀 Creating $PROJECT_NAME with Vite + React + TypeScript + shadcn/ui..."

# Step 1: Create Vite project (fully non-interactive with SWC for faster builds)
npm create vite@latest "$PROJECT_NAME" -- --template react-swc-ts --yes

# Step 2: Enter project directory
cd "$PROJECT_NAME"

# Step 3: Install ALL dependencies in a single npm install (performance optimization)
echo "📦 Installing dependencies (base + Tailwind + Zustand + TanStack)..."
npm install \
  tailwindcss \
  @tailwindcss/vite \
  zustand \
  @tanstack/react-router \
  @tanstack/react-table

npm install -D @types/node

# Step 4: Update vite.config.ts with Tailwind plugin and path alias
cat > vite.config.ts << 'EOF'
import path from "path"
import tailwindcss from "@tailwindcss/vite"
import react from "@vitejs/plugin-react-swc"
import { defineConfig } from "vite"

export default defineConfig({
  plugins: [react(), tailwindcss()],
  resolve: {
    alias: {
      "@": path.resolve(__dirname, "./src"),
    },
  },
})
EOF
echo "   ✓ vite.config.ts updated"

# Step 5: Update tsconfig.json with path aliases
cat > tsconfig.json << 'EOF'
{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
EOF
echo "   ✓ tsconfig.json updated"

# Step 6: Update tsconfig.app.json - add baseUrl and paths (cross-platform sed)
if [[ "$OSTYPE" == "darwin"* ]]; then
  sed -i '' 's/"compilerOptions": {/"compilerOptions": {\n    "baseUrl": ".",\n    "paths": { "@\/*": [".\/src\/*"] },/' tsconfig.app.json
else
  sed -i 's/"compilerOptions": {/"compilerOptions": {\n    "baseUrl": ".",\n    "paths": { "@\/*": [".\/src\/*"] },/' tsconfig.app.json
fi
echo "   ✓ tsconfig.app.json updated"

# Step 7: Create src/index.css with Tailwind import
cat > src/index.css << 'EOF'
@import "tailwindcss";
EOF
echo "   ✓ src/index.css created"

# Step 8: Initialize shadcn with defaults (non-interactive)
echo "⚙️  Initializing shadcn/ui..."
npx --yes shadcn@latest init --defaults --yes

# Step 8.5: Inject ALL shadcn registries (fetched from official source of truth)
echo "📦 Injecting all shadcn registries..."
REGISTRIES_URL="https://ui.shadcn.com/r/registries.json"

# Potentially paid/commercial registries to exclude
EXCLUDE_PAID='["@clerk","@algolia","@shadcnui-blocks","@uselayouts","@gooseui","@zippystarter","@lytenyte"]'

# Fetch registries and transform to components.json format (excluding paid)
REGISTRIES=$(curl -s "$REGISTRIES_URL" | jq --argjson exclude "$EXCLUDE_PAID" '
  [.[] | select(.name as $n | $exclude | index($n) | not)] |
  reduce .[] as $r ({}; . + {($r.name): $r.url})
')

if [ -n "$REGISTRIES" ] && [ "$REGISTRIES" != "null" ]; then
  # Inject registries into components.json
  jq --argjson regs "$REGISTRIES" '. + {registries: $regs}' components.json > components.json.tmp && \
    mv components.json.tmp components.json
  REGISTRY_COUNT=$(echo "$REGISTRIES" | jq 'keys | length')
  echo "   ✓ Injected $REGISTRY_COUNT registries (excluding paid)"
else
  echo "   ⚠ Could not fetch registries, skipping injection"
fi

# Step 9: Install ALL shadcn components
echo "📦 Installing all shadcn components..."
npx --yes shadcn@latest add --all --yes

# Step 10: Install Font Awesome (Pro with fallback to Free)
echo "🎨 Installing Font Awesome..."
FA_PRO=false

# Check for Font Awesome Pro token (env var or global npmrc)
if [ -n "$FONTAWESOME_NPM_AUTH_TOKEN" ]; then
  echo "   Found FONTAWESOME_NPM_AUTH_TOKEN, configuring Pro access..."
  cat > .npmrc << EOF
@fortawesome:registry=https://npm.fontawesome.com/
//npm.fontawesome.com/:_authToken=${FONTAWESOME_NPM_AUTH_TOKEN}
EOF
  FA_PRO=true
elif grep -q "npm.fontawesome.com" ~/.npmrc 2>/dev/null; then
  echo "   Found Font Awesome Pro in global npmrc..."
  FA_PRO=true
fi

if [ "$FA_PRO" = true ]; then
  npm install @fortawesome/fontawesome-svg-core \
    @fortawesome/pro-solid-svg-icons \
    @fortawesome/pro-regular-svg-icons \
    @fortawesome/pro-light-svg-icons \
    @fortawesome/pro-duotone-svg-icons \
    @fortawesome/sharp-solid-svg-icons \
    @fortawesome/sharp-regular-svg-icons \
    @fortawesome/react-fontawesome
  if [ $? -eq 0 ]; then
    echo "   ✓ Font Awesome Pro installed (all icon styles)"
    # Replace .npmrc with deployment-ready version (env var reference, not actual token)
    cat > .npmrc << 'NPMRC_EOF'
@fortawesome:registry=https://npm.fontawesome.com/
//npm.fontawesome.com/:_authToken=${FONTAWESOME_NPM_AUTH_TOKEN}
NPMRC_EOF
    echo "   ✓ .npmrc created (deployment-ready with env var reference)"
  else
    echo "   ⚠ Pro install failed, falling back to Free..."
    FA_PRO=false
    rm -f .npmrc  # Remove invalid npmrc
  fi
fi

if [ "$FA_PRO" = false ]; then
  echo "   Installing Font Awesome Free..."
  npm install @fortawesome/fontawesome-svg-core \
    @fortawesome/free-solid-svg-icons \
    @fortawesome/free-regular-svg-icons \
    @fortawesome/free-brands-svg-icons \
    @fortawesome/react-fontawesome
  echo "   ✓ Font Awesome Free installed"
  echo ""
  echo "   💡 To enable Pro icons, set FONTAWESOME_NPM_AUTH_TOKEN in ~/.zshrc"
  echo "      Get your token: https://fontawesome.com/account/general"
fi

# Step 11: Create ThemeProvider for Vite (not next-themes)
echo "🎨 Creating theme provider..."
mkdir -p src/components
cat > src/components/theme-provider.tsx << 'EOF'
import { createContext, useContext, useEffect, useState } from "react"

type Theme = "dark" | "light" | "system"

type ThemeProviderProps = {
  children: React.ReactNode
  defaultTheme?: Theme
  storageKey?: string
}

type ThemeProviderState = {
  theme: Theme
  setTheme: (theme: Theme) => void
}

const initialState: ThemeProviderState = {
  theme: "system",
  setTheme: () => null,
}

const ThemeProviderContext = createContext<ThemeProviderState>(initialState)

export function ThemeProvider({
  children,
  defaultTheme = "system",
  storageKey = "vite-ui-theme",
  ...props
}: ThemeProviderProps) {
  const [theme, setTheme] = useState<Theme>(
    () => (localStorage.getItem(storageKey) as Theme) || defaultTheme
  )

  useEffect(() => {
    const root = window.document.documentElement

    root.classList.remove("light", "dark")

    if (theme === "system") {
      const systemTheme = window.matchMedia("(prefers-color-scheme: dark)")
        .matches
        ? "dark"
        : "light"
      root.classList.add(systemTheme)
      return
    }

    root.classList.add(theme)
  }, [theme])

  const value = {
    theme,
    setTheme: (theme: Theme) => {
      localStorage.setItem(storageKey, theme)
      setTheme(theme)
    },
  }

  return (
    <ThemeProviderContext.Provider {...props} value={value}>
      {children}
    </ThemeProviderContext.Provider>
  )
}

export const useTheme = () => {
  const context = useContext(ThemeProviderContext)

  if (context === undefined)
    throw new Error("useTheme must be used within a ThemeProvider")

  return context
}
EOF
echo "   ✓ src/components/theme-provider.tsx created"

# Step 12: Create ModeToggle component (use correct FA package based on license)
if [ "$FA_PRO" = true ]; then
  FA_IMPORT='import { faSunBright, faMoonStars } from "@fortawesome/pro-solid-svg-icons"'
  FA_SUN_ICON="faSunBright"
  FA_MOON_ICON="faMoonStars"
else
  FA_IMPORT='import { faSun, faMoon } from "@fortawesome/free-solid-svg-icons"'
  FA_SUN_ICON="faSun"
  FA_MOON_ICON="faMoon"
fi

cat > src/components/mode-toggle.tsx << EOF
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome"
${FA_IMPORT}
import { Button } from "@/components/ui/button"
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuTrigger,
} from "@/components/ui/dropdown-menu"
import { useTheme } from "@/components/theme-provider"

export function ModeToggle() {
  const { setTheme } = useTheme()

  return (
    <DropdownMenu>
      <DropdownMenuTrigger asChild>
        <Button variant="default" size="icon">
          <FontAwesomeIcon
            icon={${FA_SUN_ICON}}
            className="h-[1.2rem] w-[1.2rem] rotate-0 scale-100 transition-all dark:-rotate-90 dark:scale-0"
          />
          <FontAwesomeIcon
            icon={${FA_MOON_ICON}}
            className="absolute h-[1.2rem] w-[1.2rem] rotate-90 scale-0 transition-all dark:rotate-0 dark:scale-100"
          />
          <span className="sr-only">Toggle theme</span>
        </Button>
      </DropdownMenuTrigger>
      <DropdownMenuContent align="end">
        <DropdownMenuItem onClick={() => setTheme("light")}>
          Light
        </DropdownMenuItem>
        <DropdownMenuItem onClick={() => setTheme("dark")}>
          Dark
        </DropdownMenuItem>
        <DropdownMenuItem onClick={() => setTheme("system")}>
          System
        </DropdownMenuItem>
      </DropdownMenuContent>
    </DropdownMenu>
  )
}
EOF
echo "   ✓ src/components/mode-toggle.tsx created"

# Step 13: Create base Zustand store
echo "📦 Creating Zustand store..."
mkdir -p src/stores
cat > src/stores/index.ts << 'EOF'
import { create } from 'zustand'
import { persist } from 'zustand/middleware'

interface AppState {
  // UI State
  sidebarOpen: boolean
  setSidebarOpen: (open: boolean) => void
  toggleSidebar: () => void
}

export const useAppStore = create<AppState>()(
  persist(
    (set) => ({
      sidebarOpen: true,
      setSidebarOpen: (open) => set({ sidebarOpen: open }),
      toggleSidebar: () => set((state) => ({ sidebarOpen: !state.sidebarOpen })),
    }),
    { name: 'app-storage' }
  )
)
EOF
echo "   ✓ src/stores/index.ts created"

# Step 14: Create layout components directory
mkdir -p src/components/layout src/components/brand

# Step 15: Create Marek Health brand icon
