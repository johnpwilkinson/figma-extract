    </svg>
  )
}
LOGOEOF

cat > src/components/brand/index.ts << 'BEOF'
export { MarekLogoIcon } from "./MarekLogoIcon"
BEOF

# ===== FIGMA-EXTRACT INTEGRATION =====

echo "Setting up figma-extract integration..."

# Project-level .figma-extract.json
if [ -f "$TEMPLATES_DIR/figma-extract.json" ]; then
  cp "$TEMPLATES_DIR/figma-extract.json" .figma-extract.json
  echo "   .figma-extract.json created"
fi

# Project-level Claude Code skill
mkdir -p .claude/commands
if [ -f "$TEMPLATES_DIR/claude-commands/figma-extract.md" ]; then
  cp "$TEMPLATES_DIR/claude-commands/figma-extract.md" .claude/commands/figma-extract.md
  echo "   .claude/commands/figma-extract.md installed"
fi

echo ""
echo "Done! Project $PROJECT_NAME created."
echo ""
echo "Structure:"
echo "  src/components/ui/       shadcn components (all installed)"
echo "  src/components/layout/   layout components"
echo "  src/components/brand/    brand assets (MarekLogoIcon)"
echo "  src/components/          theme-provider, mode-toggle"
echo "  src/stores/              Zustand stores"
echo "  .figma-extract.json      figma-extract CLI config"
echo "  .claude/commands/        figma-extract skill (use /figma-extract)"
echo ""
echo "Stack:"
if [ "$USE_NEXT" = true ]; then
  echo "  Next.js + TypeScript + Tailwind CSS v4"
else
  echo "  Vite + React + TypeScript + Tailwind CSS v4"
fi
echo "  shadcn/ui (all components)"
echo "  TanStack Table"
echo "  Zustand"
echo "  Font Awesome $([ "$FA_PRO" = true ] && echo "Pro" || echo "Free")"
echo ""
echo "To start:"
echo "  cd $PROJECT_NAME && bun dev"
echo ""
echo "To use figma-extract:"
echo "  /figma-extract <figma-url>"
